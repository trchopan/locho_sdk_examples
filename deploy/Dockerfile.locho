FROM rust:1.96.0-bookworm AS build
ARG LOCHO_REVISION=3786da3127338b2530e0cd8cea8ef23bc6d55dfd
WORKDIR /source
RUN git init && git remote add origin https://github.com/trchopan/locho.git && \
    git fetch --depth 1 origin "$LOCHO_REVISION" && git checkout --detach FETCH_HEAD && \
    test "$(git rev-parse HEAD)" = "$LOCHO_REVISION" && cargo build --locked --release --bin locho

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/* && \
    useradd --uid 10001 --create-home locho && mkdir /state && chown locho:locho /state
COPY --from=build /source/target/release/locho /usr/local/bin/locho
ENV LOCHO_STATE_DIR=/state
USER locho
ENTRYPOINT ["locho"]
CMD ["host", "--config", "/etc/locho/locho.toml"]
