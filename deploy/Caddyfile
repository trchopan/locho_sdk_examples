# Supply NOTES_HOSTNAME (a domain you control). Caddy obtains public HTTPS certs.
{$NOTES_HOSTNAME} {
    root * /srv
    encode zstd gzip
    header {
        Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://dns.iroh.link https://*.iroh.link wss://*.iroh.link; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
    }
    @wasm path *.wasm
    header @wasm Content-Type application/wasm
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    @document not path /assets/*
    header @document Cache-Control "no-store"
    file_server
}
